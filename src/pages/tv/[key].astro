---
import NoAccess from "@/components/NoAccess.astro";
import BrandHeader from "@/components/branding/BrandHeader.astro";
import { TvSeatingView } from "@/components/tv/TvSeatingView";
import Layout from "@/layouts/Layout.astro";
import { accessFor, tvPath } from "@/lib/access";
import { getEventBranding } from "@/lib/branding";
import { getDb } from "@/lib/db";
import { ROOM_PIN_PARAM, parseRoomPin, resolveRoomPin, tvRoomNames } from "@/lib/tv-rooms";
import { getTvScreen } from "@/lib/tv-spotlight";
import { tvScreenMessages } from "@/lib/tv-spotlight/messages";

// Read-only TV view (S-03, FR-008, NFR-003, NFR-006): the published seating on the venue plan, refreshed by polling,
// with what the organizer puts over it (tv-spotlight: a question, an AI topic, a drawn guest). TvAccess carries no
// keys, and only the TV state (names on tables, the spotlight text, no ids) and the event name reach the HTML, so
// nothing here can leak the organizer link or working data. The middleware has already checked the key (the one in
// this URL); this is the second, role-specific check.
// The TV is a full screen: no language switch on it; it follows its language cookie (or `?lang=`).
const locale = Astro.locals.locale;
const access = accessFor(Astro.locals, "tv");
const db = access ? getDb() : null;
if (!access || !db) {
  Astro.response.status = 404;
}

const initial = access && db ? await getTvScreen(db, access.event.id, access.event.modules.tvSpotlight) : null;
// tv-room-rotation (S-20): `?sala=<room name>` pins this TV to one room of THIS event. Resolved here against the
// published rooms: only a room's own name reaches the HTML, never the raw parameter; anything else = no pin.
const fixedRoom = initial
  ? resolveRoomPin(parseRoomPin(Astro.url.searchParams.get(ROOM_PIN_PARAM)), tvRoomNames(initial.tables))
  : null;
const view =
  access && db && initial
    ? {
        name: access.event.name,
        apiBase: `/api${tvPath(Astro.params.key ?? "")}`,
        initial,
        // event-branding (S-18): a small corner badge with the restaurant's and the client's brand (page load only).
        branding: await getEventBranding(db, access.event.id),
      }
    : null;
---

{view ? (
  <Layout title={tvScreenMessages(locale).pageTitle(view.name)} languageSwitch={false}>
    <main class="fixed inset-0 overflow-hidden bg-neutral-950 text-white">
      <TvSeatingView
        client:load
        apiBase={view.apiBase}
        initial={view.initial}
        eventName={view.name}
        fixedRoom={fixedRoom}
        locale={locale}
      />
      <BrandHeader branding={view.branding} base={`${view.apiBase}/branding`} locale={locale} variant="tv" />
    </main>
  </Layout>
) : (
  <NoAccess />
)}
