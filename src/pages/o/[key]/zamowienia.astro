---
import NoAccess from "@/components/NoAccess.astro";
import LeadBanner from "@/components/lead/LeadBanner.astro";
import ReadOnlyFrame from "@/components/lead/ReadOnlyFrame.astro";
import { OfflineSync } from "@/components/offline/OfflineSync";
import { OrderManager } from "@/components/orders/OrderManager";
import Layout from "@/layouts/Layout.astro";
import { accessFor, organizerPath } from "@/lib/access";
import { getDb } from "@/lib/db";
import { getOrderBoard } from "@/lib/orders";
import { orderMessages } from "@/lib/orders/messages";

// Organizer order page (restaurant-orders): the evening's food order with prices, totals, „Wydane” ticks and where
// each line is served. The middleware has already checked the key; this is the second, role-specific check.
const locale = Astro.locals.locale;
const t = orderMessages(locale);
const access = accessFor(Astro.locals, "organizer");
const db = access ? getDb() : null;
if (!access || !db) {
  Astro.response.status = 404;
}

const view =
  access && db
    ? {
        name: access.event.name,
        // client-restaurant-split: while the venue leads, the page is view-only.
        venueLeads: access.event.venueLeads,
        panelPath: organizerPath(access.event.organizerKey),
        apiBase: `/api${organizerPath(access.event.organizerKey)}`,
        board: await getOrderBoard(db, access.event.id),
      }
    : null;
---

{view ? (
  <Layout title={t.pageTitle(view.name)}>
    <main class="mx-auto flex max-w-3xl flex-col gap-6 p-4 sm:p-8 lg:max-w-6xl">
      <header class="flex flex-col gap-2">
        <a
          href={view.panelPath}
          class="self-start py-2 text-sm text-muted-foreground underline-offset-4 hover:underline"
        >
          {t.backToPanel}
        </a>
        <h1 class="text-3xl font-bold">{t.heading}</h1>
        <p class="text-sm text-muted-foreground">{t.intro}</p>
      </header>
      {view.venueLeads && <LeadBanner kind="client" locale={locale} />}
      <OfflineSync client:load apiBase={view.apiBase} locale={locale} />
      <ReadOnlyFrame readOnly={view.venueLeads} locale={locale}>
        <OrderManager client:load apiBase={view.apiBase} initial={view.board} locale={locale} />
      </ReadOnlyFrame>
    </main>
  </Layout>
) : (
  <NoAccess />
)}
