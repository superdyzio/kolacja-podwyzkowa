---
import NoAccess from "@/components/NoAccess.astro";
import LeadBanner from "@/components/lead/LeadBanner.astro";
import ReadOnlyFrame from "@/components/lead/ReadOnlyFrame.astro";
import { SeatingEditor } from "@/components/seating/SeatingEditor";
import Layout from "@/layouts/Layout.astro";
import { accessFor, organizerPath } from "@/lib/access";
import { getDb } from "@/lib/db";
import { getNeighbourHistory, getSeatingBoard } from "@/lib/seating";
import { seatingEditorMessages } from "@/lib/seating/messages";

// Organizer seating page (S-03/S-04, FR-004, FR-007, FR-009, FR-010): draw a draft, seat guests on concrete seats,
// swap, pin, publish to the TV, go back to the previous arrangement.
// The middleware has already checked the key; this is the second, role-specific check.
const locale = Astro.locals.locale;
const t = seatingEditorMessages(locale);
const access = accessFor(Astro.locals, "organizer");
const db = access ? getDb() : null;
if (!access || !db) {
  Astro.response.status = 404;
}

const view =
  access && db
    ? {
        name: access.event.name,
        // client-restaurant-split: while the venue leads, the page is view-only.
        venueLeads: access.event.venueLeads,
        // event-modules: the draw button only while the seating draw module is on.
        drawEnabled: access.event.modules.seatingDraw,
        panelPath: organizerPath(access.event.organizerKey),
        apiBase: `/api${organizerPath(access.event.organizerKey)}`,
        board: await getSeatingBoard(db, access.event.id),
        history: await getNeighbourHistory(db, access.event.id),
      }
    : null;
---

{view ? (
  <Layout title={t.pageTitle(view.name)}>
    <main class="mx-auto flex max-w-6xl flex-col gap-6 p-4 sm:p-8">
      <header class="flex flex-col gap-2">
        <a
          href={view.panelPath}
          class="self-start py-2 text-sm text-muted-foreground underline-offset-4 hover:underline"
        >
          {t.backToPanel}
        </a>
        <h1 class="text-3xl font-bold">{t.heading}</h1>
        <p class="max-w-3xl text-sm text-muted-foreground">{t.intro}</p>
      </header>
      {view.venueLeads && <LeadBanner kind="client" locale={locale} />}
      <ReadOnlyFrame readOnly={view.venueLeads} locale={locale}>
        <SeatingEditor
          client:load
          apiBase={view.apiBase}
          panelPath={view.panelPath}
          initialBoard={view.board}
          initialHistory={view.history}
          drawEnabled={view.drawEnabled}
          locale={locale}
        />
      </ReadOnlyFrame>
    </main>
  </Layout>
) : (
  <NoAccess />
)}
