---
import NoAccess from "@/components/NoAccess.astro";
import { GuestManager } from "@/components/guests/GuestManager";
import Layout from "@/layouts/Layout.astro";
import { accessFor, organizerPath } from "@/lib/access";
import { getDb } from "@/lib/db";
import { getGuestList } from "@/lib/guests";

// Organizer guest page (S-01, FR-001..FR-003): guest list, inseparable groups and absences.
// The middleware has already checked the key; this is the second, role-specific check.
const access = accessFor(Astro.locals, "organizer");
const db = access ? getDb() : null;
if (!access || !db) {
  Astro.response.status = 404;
}

const view =
  access && db
    ? {
        name: access.event.name,
        panelPath: organizerPath(access.event.organizerKey),
        apiBase: `/api${organizerPath(access.event.organizerKey)}`,
        list: await getGuestList(db),
      }
    : null;
---

{view ? (
  <Layout title={`Goście i grupy — ${view.name}`}>
    <main class="mx-auto flex max-w-3xl flex-col gap-6 p-4 sm:p-8">
      <header class="flex flex-col gap-2">
        <a
          href={view.panelPath}
          class="self-start py-2 text-sm text-muted-foreground underline-offset-4 hover:underline"
        >
          ← Panel organizatora
        </a>
        <h1 class="text-3xl font-bold">Goście i grupy</h1>
        <p class="text-sm text-muted-foreground">
          Wyświetlana nazwa to imię lub ksywka, którą zobaczą wszyscy na TV i karteczkach. Pary i grupy zawsze siedzą
          razem; nieobecni nie dostaną miejsca.
        </p>
      </header>
      <GuestManager client:load apiBase={view.apiBase} initialList={view.list} />
    </main>
  </Layout>
) : (
  <NoAccess />
)}
