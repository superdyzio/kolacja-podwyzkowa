---
import NoAccess from "@/components/NoAccess.astro";
import { OfflineSync } from "@/components/offline/OfflineSync";
import { ResetPanel } from "@/components/reset/ResetPanel";
import Layout from "@/layouts/Layout.astro";
import { accessFor, organizerPath, restaurantPath, tvPath } from "@/lib/access";
import { getAiProviderStatus } from "@/lib/ai";
import { formatAiTopicSummary, MAX_EVENT_TOPICS, MAX_GUEST_TOPICS } from "@/lib/ai-topics/limits";
import { getAiTopicUsage } from "@/lib/ai-topics/service";
import { getDb } from "@/lib/db";
import { formatGuestLinksSummary, getGuestAccessEnabled } from "@/lib/guest-links";
import { formatGuessSummary, getGuessBoard } from "@/lib/guesses";
import { formatOrderSummary, getOrderItems, orderTotals } from "@/lib/orders";
import { formatGuestSummary, summarizeGuestList } from "@/lib/guests";
import { formatQuestionSummary, getQuestionList } from "@/lib/questions";
import { formatSeatingSummary, getSeatingBoard, summarizeSeating } from "@/lib/seating";
import { shellMessages } from "@/lib/shell/messages";
import { formatVenueSummary, summarizeVenue } from "@/lib/venue";

// Organizer view (shell). The middleware has already checked the key; this is the second, role-specific check.
const locale = Astro.locals.locale;
const t = shellMessages(locale);
const access = accessFor(Astro.locals, "organizer");
if (!access) {
  Astro.response.status = 404;
}

const db = access ? getDb() : null;
// One read of the seating board carries the guest list and the venue too.
const [board, guestAccessEnabled, guessBoard, questionList, aiUsage, orderItems] = db
  ? await Promise.all([
      getSeatingBoard(db),
      getGuestAccessEnabled(db),
      getGuessBoard(db),
      getQuestionList(db),
      getAiTopicUsage(db, locale),
      getOrderItems(db),
    ])
  : [null, false, null, null, null, null];
const view = access
  ? {
      name: access.event.name,
      apiBase: `/api${organizerPath(access.event.organizerKey)}`,
      organizerUrl: new URL(organizerPath(access.event.organizerKey), Astro.url).href,
      tvUrl: new URL(tvPath(access.event.tvKey), Astro.url).href,
      restaurantUrl: new URL(restaurantPath(access.event.restaurantKey), Astro.url).href,
      guestsPath: `${organizerPath(access.event.organizerKey)}/goscie`,
      guestSummary: board ? formatGuestSummary(summarizeGuestList(board.guestList), locale) : null,
      venuePath: `${organizerPath(access.event.organizerKey)}/sale`,
      venueSummary: board ? formatVenueSummary(summarizeVenue(board.venue), locale) : null,
      seatingPath: `${organizerPath(access.event.organizerKey)}/rozsadzenie`,
      seatingSummary: board
        ? formatSeatingSummary(summarizeSeating(board), board.published, board.upToDate, locale)
        : null,
      linksPath: `${organizerPath(access.event.organizerKey)}/linki`,
      linksSummary: board
        ? formatGuestLinksSummary({ enabled: guestAccessEnabled, guestCount: board.guestList.guests.length }, locale)
        : null,
      guessesPath: `${organizerPath(access.event.organizerKey)}/strzaly`,
      guessesSummary: guessBoard ? formatGuessSummary(guessBoard, locale) : null,
      questionsPath: `${organizerPath(access.event.organizerKey)}/pytania`,
      questionsSummary: questionList ? formatQuestionSummary(questionList.questions, locale) : null,
      aiTopicsPath: `${organizerPath(access.event.organizerKey)}/pytania#tematy-ai`,
      aiTopicsSummary: aiUsage ? formatAiTopicSummary(aiUsage, getAiProviderStatus(locale), locale) : null,
      readoutPath: `${organizerPath(access.event.organizerKey)}/odczyt`,
      ordersPath: `${organizerPath(access.event.organizerKey)}/zamowienia`,
      ordersSummary: orderItems ? formatOrderSummary(orderTotals(orderItems), locale) : null,
    }
  : null;
---

{view ? (
  <Layout title={t.pageTitle(view.name)}>
    <main class="mx-auto flex max-w-3xl flex-col gap-8 p-4 sm:p-8">
      <header class="flex flex-col gap-1">
        <p class="text-sm text-muted-foreground">{t.kicker}</p>
        <h1 class="text-3xl font-bold">{view.name}</h1>
      </header>
      <OfflineSync client:load apiBase={view.apiBase} locale={locale} />

      <section aria-labelledby="links-heading" class="flex flex-col gap-4 rounded-xl border p-4 sm:p-6">
        <h2 id="links-heading" class="text-xl font-semibold">
          {t.linksHeading}
        </h2>
        <div class="flex flex-col gap-2">
          <label for="organizer-link" class="font-medium">
            {t.organizerLink}
          </label>
          <input
            id="organizer-link"
            type="text"
            readonly
            value={view.organizerUrl}
            class="w-full rounded-md border bg-muted px-3 py-2 font-mono text-sm"
          />
          <p class="text-sm text-muted-foreground">{t.organizerLinkHint}</p>
        </div>
        <div class="flex flex-col gap-2">
          <label for="tv-link" class="font-medium">
            {t.tvLink}
          </label>
          <input
            id="tv-link"
            type="text"
            readonly
            value={view.tvUrl}
            class="w-full rounded-md border bg-muted px-3 py-2 font-mono text-sm"
          />
          <p class="text-sm text-muted-foreground">{t.tvLinkHint}</p>
        </div>
        <div class="flex flex-col gap-2">
          <label for="restaurant-link" class="font-medium">
            {t.restaurantLink}
          </label>
          <input
            id="restaurant-link"
            type="text"
            readonly
            value={view.restaurantUrl}
            class="w-full rounded-md border bg-muted px-3 py-2 font-mono text-sm"
          />
          <p class="text-sm text-muted-foreground">{t.restaurantLinkHint}</p>
        </div>
      </section>

      <section aria-labelledby="sections-heading" class="flex flex-col gap-4">
        <h2 id="sections-heading" class="text-xl font-semibold">
          {t.sectionsHeading}
        </h2>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <li>
            <a
              href={view.guestsPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.guestsTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.guestsText}</p>
              {view.guestSummary && <p class="text-sm font-medium">{view.guestSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.venuePath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.venueTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.venueText}</p>
              {view.venueSummary && <p class="text-sm font-medium">{view.venueSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.seatingPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.seatingTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.seatingText}</p>
              {view.seatingSummary && <p class="text-sm font-medium">{view.seatingSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.linksPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.linksTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.linksText}</p>
              {view.linksSummary && <p class="text-sm font-medium">{view.linksSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.guessesPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.guessesTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.guessesText}</p>
              {view.guessesSummary && <p class="text-sm font-medium">{view.guessesSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.questionsPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.questionsTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.questionsText}</p>
              {view.questionsSummary && <p class="text-sm font-medium">{view.questionsSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.aiTopicsPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.aiTopicsTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.aiTopicsText(MAX_GUEST_TOPICS, MAX_EVENT_TOPICS)}</p>
              {view.aiTopicsSummary && <p class="text-sm font-medium">{view.aiTopicsSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.ordersPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.ordersTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.ordersText}</p>
              {view.ordersSummary && <p class="text-sm font-medium">{view.ordersSummary}</p>}
            </a>
          </li>
          <li>
            <a
              href={view.readoutPath}
              class="flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold">{t.readoutTitle}</h3>
                <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.open}</span>
              </div>
              <p class="text-sm text-muted-foreground">{t.readoutText}</p>
            </a>
          </li>
        </ul>
      </section>

      <section
        aria-labelledby="reset-heading"
        class="flex flex-col gap-3 rounded-xl border border-destructive/40 p-4 sm:p-6"
      >
        <h2 id="reset-heading" class="text-xl font-semibold">
          {t.resetHeading}
        </h2>
        <p class="text-sm text-muted-foreground">{t.resetText}</p>
        <ResetPanel client:load apiBase={view.apiBase} locale={locale} />
      </section>
    </main>
  </Layout>
) : (
  <NoAccess />
)}
