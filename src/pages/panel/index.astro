---
import Layout from "@/layouts/Layout.astro";
import NoAccess from "@/components/NoAccess.astro";
import LegalLinks from "@/components/legal/LegalLinks.astro";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { getMemberships } from "@/lib/auth/service";
import { authErrorText, authMessages } from "@/lib/auth/messages";
import { PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH } from "@/lib/auth/limits";
import { getDb } from "@/lib/db";
import { PRODUCT_NAME } from "@/lib/i18n/product";

// The staff panel hub (staff-accounts, F-03; platform-restaurants, S-10): who is logged in, the platform-admin marker
// with the way into the platform panel, the person's restaurants with roles — each active one linked to its restaurant
// panel, a disabled one marked and explained — password change and logout (plain forms, answers are 303 back here).
// The middleware already sent anyone without a session to the login page; the re-check below only guards against a
// misconfigured middleware. The footer links the DRAFT terms and privacy policy (landing-legal, S-30).
const t = authMessages(Astro.locals.locale);
const staff = Astro.locals.staff;
const db = getDb();
const memberships = staff && db ? await getMemberships(db, staff.accountId) : [];
const error = authErrorText(Astro.url.searchParams.get("blad"), Astro.locals.locale);
const changed = Astro.url.searchParams.get("haslo") === "zmienione";
if (!staff) {
  Astro.response.status = 404;
}
---

{staff ? (
  <Layout title={t.panelTitle}>
    <main class="mx-auto flex max-w-3xl flex-col gap-8 p-4 sm:p-8">
      <header class="flex flex-col gap-1">
        <p class="text-sm text-muted-foreground">{PRODUCT_NAME}</p>
        <h1 class="text-3xl font-bold">{t.panelHeading}</h1>
        <p>
          {t.signedInAs} <strong>{staff.displayName ?? staff.email}</strong>
          {staff.displayName && <span class="text-muted-foreground"> ({staff.email})</span>}
        </p>
        {staff.isPlatformAdmin && (
          <p>
            <span class="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">{t.platformAdmin}</span>
          </p>
        )}
      </header>

      {staff.isPlatformAdmin && (
        <section aria-labelledby="platform-heading" class="flex flex-col gap-3 rounded-xl border p-4 sm:p-6">
          <h2 id="platform-heading" class="text-xl font-semibold">
            {t.platformCardHeading}
          </h2>
          <p class="text-sm text-muted-foreground">{t.platformCardText}</p>
          <a
            href="/panel/platforma"
            class="self-start rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
          >
            {t.openPlatformPanel}
          </a>
        </section>
      )}

      {changed && (
        <p role="status" aria-label={t.noticeRegion} class="rounded-md border bg-muted p-3 text-sm">
          {t.passwordChanged}
        </p>
      )}

      <section aria-labelledby="restaurants-heading" class="flex flex-col gap-3 rounded-xl border p-4 sm:p-6">
        <h2 id="restaurants-heading" class="text-xl font-semibold">
          {t.restaurantsHeading}
        </h2>
        {memberships.length === 0 ? (
          <p class="text-muted-foreground">{t.noRestaurants}</p>
        ) : (
          <ul class="flex flex-col gap-3">
            {memberships.map((m) => (
              <li class="flex flex-col gap-1" data-restaurant-id={m.restaurantId}>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-medium">{m.restaurantName}</span>
                  <span class="flex flex-wrap gap-2">
                    {m.disabled && (
                      <span class="rounded-full border border-destructive/50 px-2 py-0.5 text-sm text-destructive">
                        {t.restaurantDisabled}
                      </span>
                    )}
                    <span class="rounded-full border px-2 py-0.5 text-sm">{t.roleLabels[m.role]}</span>
                  </span>
                </div>
                {m.disabled ? (
                  <p class="text-sm text-muted-foreground">{t.restaurantDisabledNote}</p>
                ) : (
                  <a
                    href={`/panel/restauracje/${String(m.restaurantId)}`}
                    class="self-start rounded-md border px-3 py-1.5 text-sm font-medium"
                    aria-label={t.openRestaurantPanelFor(m.restaurantName)}
                  >
                    {t.openRestaurantPanel}
                  </a>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section id="haslo" aria-labelledby="password-heading" class="flex flex-col gap-4 rounded-xl border p-4 sm:p-6">
        <h2 id="password-heading" class="text-xl font-semibold">
          {t.changePasswordHeading}
        </h2>
        <p class="text-sm text-muted-foreground">{t.changePasswordHint}</p>
        {error && (
          <p
            role="alert"
            aria-label={t.errorRegion}
            class="rounded-md border border-destructive/40 bg-destructive/10 p-3 text-sm"
          >
            {error}
          </p>
        )}
        <form method="post" action="/api/panel/password" class="flex flex-col gap-4">
          <input type="email" name="username" value={staff.email} autocomplete="username" hidden readonly />
          <div class="flex flex-col gap-2">
            <label for="current" class="font-medium">
              {t.currentPasswordLabel}
            </label>
            <Input id="current" name="current" type="password" autoComplete="current-password" required />
          </div>
          <div class="flex flex-col gap-2">
            <label for="password" class="font-medium">
              {t.newPasswordLabel}
            </label>
            <Input
              id="password"
              name="password"
              type="password"
              autoComplete="new-password"
              minLength={PASSWORD_MIN_LENGTH}
              maxLength={PASSWORD_MAX_LENGTH}
              aria-describedby="password-hint"
              required
            />
            <p id="password-hint" class="text-sm text-muted-foreground">
              {t.newPasswordHint}
            </p>
          </div>
          <div class="flex flex-col gap-2">
            <label for="repeat" class="font-medium">
              {t.repeatPasswordLabel}
            </label>
            <Input
              id="repeat"
              name="repeat"
              type="password"
              autoComplete="new-password"
              minLength={PASSWORD_MIN_LENGTH}
              maxLength={PASSWORD_MAX_LENGTH}
              required
            />
          </div>
          <Button type="submit" className="self-start">
            {t.changePasswordButton}
          </Button>
        </form>
      </section>

      <section aria-labelledby="session-heading" class="flex flex-col gap-3 rounded-xl border p-4 sm:p-6">
        <h2 id="session-heading" class="text-xl font-semibold">
          {t.sessionHeading}
        </h2>
        <p class="text-sm text-muted-foreground">{t.sessionHint}</p>
        <div class="flex flex-wrap gap-2">
          <form method="post" action="/api/auth/logout">
            <Button type="submit" variant="outline">
              {t.logoutButton}
            </Button>
          </form>
          <form method="post" action="/api/auth/logout">
            <input type="hidden" name="wszedzie" value="1" />
            <Button type="submit" variant="outline">
              {t.logoutEverywhereButton}
            </Button>
          </form>
        </div>
      </section>

      <LegalLinks class="border-t pt-4" />
    </main>
  </Layout>
) : (
  <NoAccess />
)}
