---
import LegalDocumentPage from "@/components/legal/LegalDocumentPage.astro";
import Layout from "@/layouts/Layout.astro";
import { LEGAL_DRAFT_HEADERS, termsMessages } from "@/lib/legal";

// The DRAFT terms of service (landing-legal, S-30; FR-041, PRD v2 Open Question 6): public, static, PL / EN by the
// language cookie, marked „Wersja robocza — do przeglądu prawnika” with every open field as a placeholder. Never
// cached or indexed until the legal review. No DB read.
const doc = termsMessages(Astro.locals.locale);
for (const [name, value] of Object.entries(LEGAL_DRAFT_HEADERS)) {
  Astro.response.headers.set(name, value);
}
---

<Layout title={doc.pageTitle}>
  <LegalDocumentPage kind="terms" doc={doc} />
</Layout>
