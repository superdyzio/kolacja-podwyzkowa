---
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { hasEvent } from "@/lib/event";
import { shellMessages } from "@/lib/shell/messages";

// Public entry. Before the event exists it offers one-time creation (POST /api/event → organizer page with links).
// Once it exists it shows only the no-access message: the organizer enters through the bookmarked link.
const t = shellMessages(Astro.locals.locale);
const db = getDb();
const eventExists = db ? await hasEvent(db) : null;

Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout>
  <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-4 p-6">
    <h1 class="text-3xl font-bold">{t.appName}</h1>
    {eventExists === null && <p class="text-muted-foreground">{t.noDatabase}</p>}
    {eventExists === false && (
      <>
        <p class="text-muted-foreground">{t.noEventYet}</p>
        <p class="text-muted-foreground">{t.bookmarkNow}</p>
        <form method="post" action="/api/event">
          <Button type="submit" size="lg">
            {t.createEvent}
          </Button>
        </form>
      </>
    )}
    {eventExists === true && <p class="text-muted-foreground">{t.linkOnly}</p>}
  </main>
</Layout>
