---
import Layout from "@/layouts/Layout.astro";
import { noAccessMessages } from "@/lib/access/messages";

// The no-access page (PRD Access Control): shown for unknown routes and for every request without a valid link key
// (also a guest link while guest access is off or after it was revoked). Deliberately contains no event data and the
// same words whatever the reason. Callers set the 404 status.
const t = noAccessMessages(Astro.locals.locale);
---

<Layout title={t.title}>
  <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-4 p-6 text-center">
    <h1 class="text-3xl font-bold">{t.title}</h1>
    <p class="text-muted-foreground">{t.text}</p>
    <p class="text-sm text-muted-foreground">{t.hint}</p>
  </main>
</Layout>
